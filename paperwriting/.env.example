# Copy this file to .env in the same application directory.
# Supply your own Chat Completions-compatible service and model.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional semantic retrieval. Disabled by default; no model download at startup.
PAPERCODING_ENABLE_EMBEDDINGS=false
# PAPERCODING_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional absolute paths. Leave commented to use application-local defaults.
# PAPERCODING_DATA_DIR=
# PAPERCODING_EMBEDDING_CACHE=
